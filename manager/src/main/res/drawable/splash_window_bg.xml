<?xml version="1.0" encoding="utf-8"?>
<!-- 开屏背景：用户壁纸 + 更深的绿色遮罩，保证竖排文字清晰 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <bitmap
            android:gravity="center"
            android:src="@drawable/wallpaper" />
    </item>
    <item>
        <shape>
            <gradient
                android:angle="0"
                android:startColor="#F20B2E16"
                android:centerColor="#D9143A1E"
                android:endColor="#B31B5E20" />
        </shape>
    </item>
</layer-list>
